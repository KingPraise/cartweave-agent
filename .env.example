# PayPal Developer Sandbox Credentials (https://developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENVIRONMENT=sandbox

# Google Gemini 3 Flash API Key (OpenAI-compatible endpoint)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# Optional OpenAI Fallback Key
OPENAI_API_KEY=your_optional_openai_api_key

# Channel3 Product Intelligence API Key (https://trychannel3.com)
CHANNEL3_API_KEY=your_channel3_api_key

# Server & Client Configuration
PORT=4001
PUBLIC_CLIENT_URL=http://localhost:5174
